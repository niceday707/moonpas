# 문파스(MoonPas) 환경변수 예시
#
# 사용법:
#   1) 이 파일을 .env.local 로 복사.
#      (Windows PowerShell)  Copy-Item .env.example .env.local
#      (bash)                cp .env.example .env.local
#   2) 아래 빈 값을 실제 값으로 채우세요.
#   3) .env.local 은 .gitignore 로 보호됩니다 — 절대 커밋하지 마세요.
#
# 보안 규칙:
#   - NEXT_PUBLIC_ 접두사가 붙은 변수는 클라이언트 번들에 포함됩니다.
#     공개돼도 되는 값에만 붙이세요.
#   - 서비스 롤 키, 서버 토큰, API 키는 NEXT_PUBLIC_ 접두사 절대 금지.

# ─── Supabase (필수) ─────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 🔒 서버 전용 — 관리자 API / 트렌딩 / 알림 / 학교 공지 크롤링 등
SUPABASE_SERVICE_ROLE_KEY=

# ─── Firebase Cloud Messaging (선택, 푸시 안 쓰면 비워둬도 됨) ───────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# 🔒 서버 전용 — Admin SDK service account JSON 한 줄
FIREBASE_SERVICE_ACCOUNT_KEY=

# ─── 기타 (선택) ─────────────────────────────────────────────────────────────
# 🔒 NEIS 급식 API 키 (data.go.kr 발급)
NEIS_API_KEY=

# 🔒 방문자 IP 해시 솔트 — 운영용은 무작위 긴 문자열 권장
VISITOR_HASH_SALT=moonpas-visitor-v1

# ─── 문츠 자동 후보 수집기 (scripts/find-muntz-candidates.mjs) ───────────────
# YouTube Data API v3 키.
# Google Cloud Console → APIs & Services → Credentials → API key 생성 후
# "YouTube Data API v3" 사용 설정.
# 🔒 서버 전용 — NEXT_PUBLIC_ 접두사 절대 금지.
YOUTUBE_API_KEY=
